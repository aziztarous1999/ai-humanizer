# Optional. Copy to .env.local for local dev, or set them in Vercel → Project → Settings → Environment Variables.
# With a key set here, visitors can use that provider without bringing their own key.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional. If set, the server keys above only work for visitors who enter this code.
# Strongly recommended on a public deployment, so strangers can't use up your free quota.
ACCESS_CODE=
